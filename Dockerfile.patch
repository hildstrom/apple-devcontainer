diff --git a/Dockerfile b/Dockerfile
index 1bd45c6..51481f9 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -30,6 +30,13 @@ RUN apt-get update && apt-get install -y --no-install-recommends \
   ipset \
   iptables \
   iproute2 \
+  # Rust for project development
+  rustup \
+  # rsyslog for project development
+  rsyslog \
+  # plantuml for project diagrams
+  plantuml \
+  graphviz \
   && apt-get clean && rm -rf /var/lib/apt/lists/*
 
 # Install git-delta
@@ -80,6 +87,11 @@ RUN curl -fsSL https://claude.ai/install.sh | bash && \
   claude plugin marketplace add trailofbits/skills && \
   claude plugin marketplace add trailofbits/skills-curated
 
+# Install Codex and move binaries out of the way for container mount
+RUN curl -fsSL https://chatgpt.com/codex/install.sh | \
+  CODEX_INSTALLER_USE_RELEASES_OPENAI_COM=false bash && \
+  mv /home/vscode/.codex /home/vscode/.codex-bin
+
 # Install Python 3.13 via uv (fast binary download, not source compilation)
 RUN uv python install 3.13 --default
 
@@ -102,11 +114,16 @@ RUN sh -c "$(curl -fsSL https://github.com/deluan/zsh-in-docker/releases/downloa
   -p git \
   -x
 
+# Install Rust for project development
+RUN rustup toolchain install stable && rustup component add clippy rustfmt
+
 # Copy zsh configuration
 COPY --chown=vscode:vscode .zshrc /home/vscode/.zshrc.custom
+COPY --chown=vscode:vscode zshrc-adevc /home/vscode/.zshrc.adevc
 
 # Append custom zshrc to the main one
 RUN echo 'source ~/.zshrc.custom' >> /home/vscode/.zshrc
+RUN echo 'source ~/.zshrc.adevc' >> /home/vscode/.zshrc
 
 # Copy post_install script
 COPY --chown=vscode:vscode post_install.py /opt/post_install.py
